{
  "name": "67speed",
  "version": "0.1.0",
  "private": false,
  "description": "A zero-login nonsense speed test for the 6-7 meme, built for static-first viral traffic.",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "package:smoke": "npm run build && npm pack --dry-run",
    "release:check": "npm run check && npm run smoke && npm run package:smoke",
    "card": "node --import tsx scripts/card.mjs",
    "generate": "node --import tsx scripts/generate.mjs"
  },
  "dependencies": {
    "next": "16.2.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "@types/react": "19.1.4",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  },
  "keywords": [
    "67speed",
    "meme",
    "nextjs",
    "static-site",
    "viral-toy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/67speed.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/67speed/issues"
  },
  "homepage": "https://github.com/rogerchappel/67speed#readme",
  "files": [
    "docs",
    "scripts",
    "src",
    "tests",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "next.config.ts",
    "next-env.d.ts",
    "tsconfig.json",
    "CONTRIBUTING.md"
  ],
  "license": "MIT",
  "author": "Roger Chappel"
}
